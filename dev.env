# General
BASE_URL=https://yourdomain.com
PORT=3000
REDIS_HOST=localhost
REDIS_PORT=6379

# Database Selection
DATABASE_TYPE=postgres # Options: postgres, mysql, sqlite

# PostgreSQL Config
PG_USER=postgres
PG_HOST=localhost
PG_NAME=url_shortener
PG_PASSWORD=yourpassword
PG_PORT=5432

# MySQL Config
MYSQL_USER=root
MYSQL_HOST=localhost
MYSQL_NAME=url_shortener
MYSQL_PASSWORD=yourpassword
MYSQL_PORT=3306

# SQLite Config
SQLITE_FILE=./url_shortener.db